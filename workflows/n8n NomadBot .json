        "assignments": {
          "assignments": [
            {
              "id": "beaf0c0b-f594-4afe-be4a-d4d4f4d834b2",
              "name": "calls",
              "value": "={{ (() => {   const t = String($json.text || '');   const s = t.indexOf('{');   const e = t.lastIndexOf('}');   if (s < 0 || e <= s) return [];   try {     const p = JSON.parse(t.slice(s, e + 1));     return Array.isArray(p.calls) ? p.calls : [];   } catch (err) {     return [];   } })() }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "a21944f1-d478-4061-9860-ba86ea7ea92c",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1136,
        208
      ]
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "calls = _items[0][\"json\"].get(\"calls\", [])\nvalid_calls = []\nseen = []\nMAX_CALLS = 3\nBAD = [\"none\", \"null\", \"n/a\", \"na\", \"general\", \"unknown\", \"undefined\", \"nothing\"]\n\nfor call in calls:\n    if not isinstance(call, dict):\n        continue\n    if str(call.get(\"tool\", \"\")) != \"open_meteo\":\n        continue\n    args = call.get(\"args\", {})\n    city = str(args.get(\"city\", \"\")).strip() if isinstance(args, dict) else \"\"\n    if city.lower() in BAD:\n        continue\n    if 0 < len(city) < 50 and city.lower() not in seen:\n        seen.append(city.lower())\n        valid_calls.append({\"json\": {\"city\": city}})\n    if len(valid_calls) >= MAX_CALLS:\n        break\n\nif not valid_calls:\n    return [{\"json\": {\"city\": \"\"}}]\nreturn valid_calls"
      },
