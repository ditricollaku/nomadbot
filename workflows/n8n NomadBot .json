    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Telegram allows max 4096 characters per message.\n# Split the itinerary into chunks and output one item per chunk.\nMAX = 4000\ntext = str(_items[0][\"json\"].get(\"text\") or _items[0][\"json\"].get(\"output\") or \"\")\nif not text.strip():\n    text = \"Sorry, I could not generate an itinerary. Please try again.\"\n\nchunks = []\nrest = text\nwhile len(rest) > MAX:\n    # Prefer cutting at a line break, then a space, otherwise hard cut\n    cut = rest.rfind(\"\\n\", 0, MAX)\n    if cut < MAX // 2:\n        cut = rest.rfind(\" \", 0, MAX)\n    if cut < MAX // 2:\n        cut = MAX\n    chunks.append(rest[:cut])\n    rest = rest[cut:].lstrip()\nif rest:\n    chunks.append(rest)\n\nreturn [{\"json\": {\"text\": chunk}} for chunk in chunks]"
      },
