    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "data = _items[0][\"json\"]\nrows = (data.get(\"query\") or {}).get(\"geosearch\") or []\nif not rows:\n    text = \"I couldn't find notable places nearby.\"\nelse:\n    lines = [\"Top places nearby:\"]\n    n = 0\n    for r in rows:\n        title = str(r.get(\"title\", \"\")).strip()\n        if not title:\n            continue\n        n += 1\n        dist = r.get(\"dist\")\n        km = \"\"\n        if isinstance(dist, (int, float)):\n            km = \" (\" + str(round(dist / 1000, 1)) + \" km from center)\"\n        line = str(n) + \". \" + title + km\n        pid = r.get(\"pageid\")\n        if isinstance(pid, int):\n            line = line + \"\\n   https://en.wikipedia.org/?curid=\" + str(pid)\n        lines.append(line)\n        if n >= 5:\n            break\n    text = \"\\n\".join(lines)\nreturn [{\"json\": {\"text\": text}}]"
      },
