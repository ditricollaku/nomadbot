      "name": "Weather Forecast"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "d = _items[0][\"json\"]\ncur = d.get(\"current\") or {}\ndaily = d.get(\"daily\") or {}\ndays = daily.get(\"time\") or []\nif not cur and not days:\n    text = \"Weather data is unavailable right now.\"\nelse:\n    lines = [\"Now: \" + str(cur.get(\"temperature_2m\")) + \" C (feels like \"\n             + str(cur.get(\"apparent_temperature\")) + \" C)\", \"\", \"Next days:\"]\n    mins = daily.get(\"temperature_2m_min\") or []\n    maxs = daily.get(\"temperature_2m_max\") or []\n    rain = daily.get(\"precipitation_probability_max\") or []\n    for i in range(len(days)):\n        lo = mins[i] if i < len(mins) else \"?\"\n        hi = maxs[i] if i < len(maxs) else \"?\"\n        rp = rain[i] if i < len(rain) else \"?\"\n        lines.append(\"- \" + str(days[i]) + \": \" + str(lo) + \" to \" + str(hi)\n                     + \" C, rain chance \" + str(rp) + \"%\")\n    text = \"\\n\".join(lines)\nreturn [{\"json\": {\"text\": text}}]"
      },
